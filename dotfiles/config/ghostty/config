# Font
font-family = CaskaydiaCove NFM
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-size = 19

# Primary colors
background = #F7F7F7
foreground = #434343

# Cursor
cursor-color = #434343
cursor-text = #F7F7F7

# Selection
selection-background = #4c566a
selection-foreground = #434343

# Normal palette (0-7)
palette = 0=#000000
palette = 1=#AA3731
palette = 2=#448C27
palette = 3=#CB9000
palette = 4=#325CC0
palette = 5=#7A3E9D
palette = 6=#0083B2
palette = 7=#BBBBBB

# Bright palette (8-15)
palette = 8=#777777
palette = 9=#F05050
palette = 10=#60CB00
palette = 11=#FFBC5D
palette = 12=#007ACC
palette = 13=#E64CE6
palette = 14=#00AACB
palette = 15=#FFFFFF

# Scrollback
scrollback-limit = 0

# Window
# background-opacity = 0.97

# don't notify with pop up that I copied something:
app-notifications = no-clipboard-copy
